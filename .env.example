# BhandsMusic Web 环境变量示例
# 复制为 .env 并按需修改；提交前请勿将真实 .env 提交到仓库

# ---- 后端服务（apps/server）----
# 监听端口（默认 3001，与 apps/web/vite.config.ts 的代理目标保持一致）
PORT=3001
# 监听地址（容器/生产环境保持 0.0.0.0）
HOST=0.0.0.0

# LX 音源脚本管理令牌：脚本会在服务端执行任意 JS，必须凭令牌才能上传/启停（不配置则功能关闭）
# 生成示例：node -e "console.log(require('crypto').randomUUID())"
ADMIN_TOKEN=

# 跨域白名单（逗号分隔完整 origin，同源请求与 localhost 开发地址始终放行；留空即可单域名部署）
CORS_ORIGINS=

# 音频流代理额外放行的 CDN 域名后缀（逗号分隔；默认已覆盖网易云/咪咕/酷狗/酷我/QQ音乐/joox/tidal）
STREAM_HOST_ALLOWLIST=

# 登录会话持久化：默认关闭（部署安全侧 —— 磁盘上不出现任何网易云登录凭据，重启后用户需重新扫码）
# 本地测试想保留「重启免重新扫码」时设为 on
SESSION_PERSIST=

# 信任反向代理头：仅在 Caddy/nginx 反代后面部署时设为 1
# （Secure cookie 与按 IP 限流才取到真实客户端值）；直连暴露 3001 端口的部署必须保持空 ——
# trustProxy 会信任可伪造的 X-Forwarded-For，限流可被绕过
TRUST_PROXY=

# 运行时数据目录（LX 脚本存档；SESSION_PERSIST=on 时网易云 cookie 也存这里），默认 <仓库根>/data，Docker 已挂载 ./data:/app/data
# DATA_DIR=
